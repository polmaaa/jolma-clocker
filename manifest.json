{
  "manifest_version": 3,
  "name": "Jolma CLocker - Browser Security Guard",
  "version": "0.2.1",
  "author": "Polma Sihotang",
  "description": "Jolma CLocker (Chrome Locker) - Pengaman browser modern dengan proteksi kata sandi, auto-fullscreen, dan shortcut instan. Dibuat oleh Polma Sihotang.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "power",
    "alarms",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "lock.html"
  },
  "commands": {
    "lock-browser-command": {
      "suggested_key": {
        "default": "Ctrl+L",
        "mac": "Command+L"
      },
      "description": "Kunci Browser Instan (Fullscreen & Lock)"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
