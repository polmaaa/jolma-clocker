{
  "manifest_version": 3,
  "name": "Krompol Locker",
  "version": "0.2.1",
  "description": "Mengamankan aktivitas browser Chrome Anda dengan proteksi kata sandi.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "power",
    "alarms",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "lock.html"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
